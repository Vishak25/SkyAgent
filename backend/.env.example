## Backend environment (example)
#
# Copy to `backend/.env` and fill values.
# DO NOT commit real keys.

# FlightAware AeroAPI v4
FLIGHTAWARE_API_KEY=

# CheckWX METAR API
CHECKWX_API_KEY=

# OpenSky OAuth2 Client Credentials (client_id / client_secret)
OPENSKY_USER=
OPENSKY_PASSWORD=

# Comma-separated list of allowed CORS origins
# Example: http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional: path to a trained model weights file
MODEL_WEIGHTS_PATH=

# Optional: scale factor applied to raw model output to convert to minutes
STGNN_OUTPUT_SCALE=100
