## SkyAgent backend environment (example)
#
# Copy to `backend/.env` and fill values.
# DO NOT commit real keys.

# ── Data source API keys ────────────────────────────────────────────────────

# FlightAware AeroAPI v4
FLIGHTAWARE_API_KEY=

# CheckWX METAR/TAF API
CHECKWX_API_KEY=

# OpenSky OAuth2 Client Credentials (client_id / client_secret)
OPENSKY_USER=
OPENSKY_PASSWORD=

# ── Server config ───────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:4200

# ── Model config ────────────────────────────────────────────────────────────

# Optional: path to a trained model weights file
MODEL_WEIGHTS_PATH=

# Scale factor applied to raw (untrained) model output to convert to minutes
STGNN_OUTPUT_SCALE=100

# ── LLM provider (any OpenAI-compatible endpoint) ──────────────────────────
#
# Default: self-hosted vLLM on a GPU node (Phase 3 — Hopper). Swap the three
# values below to point at any OpenAI-compatible provider.

# Base URL of the OpenAI-compatible endpoint
#   vLLM on Hopper: http://<gpu-node>:8000/v1   (localhost via SSH tunnel)
#   Google Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=http://localhost:8000/v1

# Bearer token. For vLLM this is the --api-key flag; for Gemini it's your
# Google AI Studio key.
LLM_API_KEY=skyagent-dev

# Model identifier
#   vLLM:   Qwen/Qwen3.5-9B-Instruct
#   Gemini: gemini-flash-latest
LLM_MODEL=Qwen/Qwen3.5-9B-Instruct

# ── Dev / test ──────────────────────────────────────────────────────────────

# Set to 1 to load responses from fixtures/ instead of live APIs
USE_FIXTURES=0
