## SkyCast / FlightPredictorAI (example environment)
#
# Copy this file to:
# - `backend/.env` (recommended)
# or set these variables in your shell environment.
#
# DO NOT commit real keys.

# ---- External API keys ----
# FlightAware AeroAPI v4
FLIGHTAWARE_API_KEY=

# CheckWX METAR API
CHECKWX_API_KEY=

# OpenSky OAuth2 Client Credentials
# Note: despite the variable names, these are expected to be OAuth2 client_id/client_secret.
OPENSKY_USER=
OPENSKY_PASSWORD=

# ---- Backend config ----
# Comma-separated list of allowed CORS origins, e.g.
# http://localhost:3000,https://yourdomain.com
CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional: path to a trained model weights file
MODEL_WEIGHTS_PATH=

# Optional: scale factor applied to raw model output to convert to minutes
STGNN_OUTPUT_SCALE=100
